# Banco (usado pelo docker-compose e pela API)
DB_NAME=javachat
DB_USER=javachat
DB_PASSWORD=javachat
DB_URL=jdbc:postgresql://localhost:5432/javachat

# Origens autorizadas a chamar a API (separadas por vírgula)
CORS_ORIGINS=http://localhost:4200

# Ssegredo de assinatura do JWT (mínimo 32 bytes)
# JWT_SECRET=

# Segredo compartilhado com o coturn para credenciais efêmeras
# TURN_SECRET=